# ===== Trading-BOT — crontab per il portatile sempre acceso =====
# CRON_TZ fissa il fuso a Roma: gli orari sotto sono CET/CEST e l'ora legale
# viene gestita da sola. Sostituisci /PERCORSO con la cartella reale del repo
# (es. /home/mario/Trading-BOT) e installa con:  crontab deploy/crontab.example
CRON_TZ=Europe/Rome

# Staffetta mattutina in ordine (01 -> 02 -> 03), giorni feriali alle 14:30
30 14 * * 1-5 /PERCORSO/deploy/pipeline.sh >> /PERCORSO/state/cron.log 2>&1

# Trader: un tick OGNI MINUTO 15:00-21:59 (il codice opera solo 15:30->21:46)
* 15-21 * * 1-5 /PERCORSO/deploy/run.sh lib.routine_04_execution >> /PERCORSO/state/cron.log 2>&1

# Riconciliazione: venerdi' 23:00
0 23 * * 5 /PERCORSO/deploy/run.sh lib.routine_05_reconciliation >> /PERCORSO/state/cron.log 2>&1

# Supervisore AI: sabato 10:00
0 10 * * 6 /PERCORSO/deploy/run.sh lib.routine_06_supervisor >> /PERCORSO/state/cron.log 2>&1

# ===== DIVISIONE CRIPTO =====
# Conto separato, mercato aperto 24 ore su 24, 7 giorni su 7: niente vincoli di
# giorni feriali o orari di borsa. Si usa crypto_run.sh, NON run.sh: quello
# esporterebbe le chiavi del conto azionario nell'ambiente.
# Gli orari sono sfalsati di 5 minuti per non accavallarsi con le routine
# azionarie sulle operazioni git.

# Classifica di momentum: una volta al giorno, tutti i giorni
0 8 * * * /PERCORSO/deploy/crypto_run.sh crypto.routine_c1_scan >> /PERCORSO/state/cron.log 2>&1

# Gestione posizioni, trailing stop e ingressi: ogni 30 minuti, sempre
5,35 * * * * /PERCORSO/deploy/crypto_run.sh crypto.routine_c2_trade >> /PERCORSO/state/cron.log 2>&1

# Rendiconto settimanale con analisi AI: domenica 22:00
0 22 * * 0 /PERCORSO/deploy/crypto_run.sh crypto.routine_c3_report >> /PERCORSO/state/cron.log 2>&1

# ===== DIVISIONE OPZIONI =====
# Conto separato (PA3YKSS69ZE0). Segue gli orari di borsa americani come le
# azioni, ma con un ritmo piu' fitto: le opzioni si muovono molto piu' in
# fretta del sottostante e una posizione puo' cambiare di segno in un'ora.
# Si usa options_run.sh, NON run.sh: quello esporterebbe le chiavi azionarie.

# Selezione dei contratti: cinque minuti dopo l'apertura di New York
35 15 * * 1-5 /PERCORSO/deploy/options_run.sh options.routine_o1_select >> /PERCORSO/state/cron.log 2>&1

# Esecuzione e gestione: ogni 15 minuti durante la sessione.
# L'ultimo giro delle 21:45 chiude le posizioni intraday (soglia 21:40).
40,55 15 * * 1-5 /PERCORSO/deploy/options_run.sh options.routine_o2_trade >> /PERCORSO/state/cron.log 2>&1
10,25,40,55 16-21 * * 1-5 /PERCORSO/deploy/options_run.sh options.routine_o2_trade >> /PERCORSO/state/cron.log 2>&1

# Il log di cron cresce senza limite: lunedi' alle 04:20 si tiene solo la coda.
20 4 * * 1 tail -n 5000 /PERCORSO/state/cron.log > /PERCORSO/state/cron.log.tmp && mv /PERCORSO/state/cron.log.tmp /PERCORSO/state/cron.log
